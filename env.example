# Pimlico API Key - Get from https://console.pimlico.io/
NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key_here

# Privy App ID - Get from https://console.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here 

# Privy Cross App ID for Monad Games ID (Provider App ID)
# Do NOT confuse with your Privy App ID
NEXT_PUBLIC_MONAD_GAMES_CROSS_APP_ID=cmd8euall0037le0my79qpz42

# Optional: Dripper/Airdrop contract to fund first-time users (0.8 MON)
# Should expose claimAirdrop() or claim()
NEXT_PUBLIC_AIRDROP_CONTRACT_ADDRESS=

# Server wallet private key used to submit scores/tx counts to Monad Games ID contract
# This must be a game-owned key registered as the _game for updatePlayerData
# Never expose this in the client. Set only in server environment (.env.local, Vercel env)
SERVER_SUBMITTER_PRIVATE_KEY=

# Monad Games ID contract address (testnet)
MONAD_GAMES_ID_CONTRACT=0xceCBFF203C8B6044F52CE23D914A1bfD997541A4
GAME_SUBMITTER_ADDRESS=0xF3b0A442334894FdDD62FCf61859f07D04029803